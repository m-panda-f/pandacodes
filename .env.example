# pandacodes Environment Configuration Example
# Copy this file to .env and configure your values:
VITE_WEB3FORMS_ACCESS_KEY="your-web3forms-access-key-here"
VITE_WEB3FORMS_API_URL="https://api.web3forms.com/submit"
VITE_CALENDLY_URL="https://calendly.com/your-username/your-meeting"
VITE_CONTACT_EMAIL="your-email@example.com"
VITE_LINKEDIN_URL="https://www.linkedin.com/in/your-profile/"
VITE_GITHUB_URL="https://github.com/your-username"
VITE_INSTAGRAM_URL="https://instagram.com/your-handle"

